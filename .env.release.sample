# ЭТО ИНСТРУМЕНТ ДЛЯ РЕЛИЗА И ПОСТОВ В ТГ И ГИТ. ДЛЯ РАБОТЫ БОТА ПОДДЕРЖКИ НЕ НУЖЕН — НЕ ЗАПОЛНЯЙТЕ, ЕСЛИ ПРОСТО ЗАПУСКАЕТЕ БОТА.
# Локальные настройки для tools/release.py (скопируйте в .env.release — в git не кладётся).
# python tools/release.py preview|github|telegram|publish

# Токен отдельного announce-бота (не BOT_TOKEN бота поддержки).
RELEASE_TG_BOT_TOKEN=

# HTTP-прокси до api.telegram.org (если Clash/VPN даёт fake-IP 198.18.*), напр. http://127.0.0.1:7890.
# SOCKS не поддерживается. Если прокси не поднят, утилита сама повторит отправку напрямую —
# только когда запрос заведомо не дошёл до Telegram, чтобы анонс не ушёл дважды.
RELEASE_TG_PROXY_URL=

# Чат для анонса: @username или числовой -100…
RELEASE_TG_CHAT_ID=@meows_vpn_bot

# Id темы форума (для https://t.me/meows_vpn_bot/31 — это 31). Пусто — общий чат.
RELEASE_TG_MESSAGE_THREAD_ID=

# Подпись в конце поста (кликабельная).
RELEASE_TG_FOOTER_TEXT=Meows VPN Group
RELEASE_TG_FOOTER_URL=https://t.me/meows_vpn_bot
# Custom emoji перед подписью (HTML <tg-emoji>). Нужен бот с Fragment username.
RELEASE_TG_FOOTER_CUSTOM_EMOJI_ID=5451703345746058024
# Запасной обычный эмодзи, если custom emoji недоступен.
RELEASE_TG_FOOTER_CUSTOM_EMOJI_ALT=✨

# owner/repo для gh release create --repo (пусто — репозиторий origin).
RELEASE_GITHUB_REPO=MrMe0ws/telegram-support-bot

# Путь к заметкам (по умолчанию ./RELEASE_NOTES.md)
# RELEASE_NOTES_PATH=RELEASE_NOTES.md
