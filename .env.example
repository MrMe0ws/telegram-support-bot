BOT_TOKEN=
# ID супергруппы с включёнными темами (forum), бот — админ с правом управлять топиками
SUPPORT_GROUP_ID=
# Через запятую: админы (доступ к /close в топике, /block, /unblock)
ADMIN_IDS=

# Важно: в @BotFather для бота выполните /setprivacy → Disable,
# иначе бот не получает обычные сообщения из группы и ответы саппорта не доходят до клиента.

# Уровень логов в консоль: DEBUG, INFO, WARNING, ERROR, CRITICAL (по умолчанию WARNING)
# Строки aiogram «Update … is handled» скрыты, пока не выставить LOG_LEVEL=DEBUG
LOG_LEVEL=WARNING

# SQLite в контейнере по умолчанию
DATABASE_URL=sqlite+aiosqlite:////data/support.db

# Плейсхолдеры: {username}, {ticket_id}, {uid}, {name}
TOPIC_NAME_TEMPLATE={username} · {ticket_id}

# Иконки темы форума (custom emoji ID из набора Telegram для топиков). Пустое значение — не менять иконку.
# TOPIC_ICON_EMOJI_OPEN=5377316857231450742
# TOPIC_ICON_EMOJI_CLOSED=5237699328843200968

# Тексты UI: каталог texts/<BOT_LOCALE> (по умолчанию ru)
BOT_LOCALE=ru
# В Docker задано в образе. Для локального запуска при необходимости:
# TEXTS_DIR=./texts

# --- Remnawave (опционально, блок подписки в /profile) ---
# REMNAWAVE_ENABLED=true
# REMNAWAVE_URL=http://remnawave:3000
# REMNAWAVE_MODE=local
# REMNAWAVE_TOKEN=
# Как PANEL_DOMAIN в .env панели (рекомендуется при docker URL remnawave:3000)
# REMNAWAVE_HTTP_HOST=panel.example.com
# Для local по умолчанию true: X-Forwarded-For / X-Forwarded-Proto (иначе панель рвёт сокет)
# REMNAWAVE_PROXY_HEADERS=true
# REMNAWAVE_FORWARDED_FOR=127.0.0.1
# REMNAWAVE_FORWARDED_PROTO=https
# REMNAWAVE_SUB_PUBLIC_URL=https://sub.example.com

# --- Bridge к web-кабинету (remnawave-telegram-shop, SUPPORT_BOT_API=true) ---
# URL webhook shop: ответы саппорта и закрытие cabinet-тикета. В Docker — имя сервиса shop + HEALTH_CHECK_PORT.
# SHOP_WEBHOOK_URL=http://shop:8080/cabinet/api/internal/support/webhook
# Общий Bearer-секрет с shop (SUPPORT_BRIDGE_SECRET в .env shop). Без пары SHOP_WEBHOOK_URL + секрет cabinet-bridge не работает.
# SUPPORT_BRIDGE_SECRET=change-me-shared-secret
# Порт HTTP sidecar: POST /internal/cabinet/message (shop шлёт сюда через SUPPORT_BOT_API_URL)
# HTTP_PORT=8080
# REMNAWAVE_TIMEOUT_SEC=10
# BOT_TIMEZONE=Europe/Moscow

# REMNAWAVE_MODE=remote — если бот на другой машине, через публичный URL:
# REMNAWAVE_URL=https://panel.example.com
# REMNAWAVE_GATE_QUERY_NAME=
# REMNAWAVE_GATE_QUERY_VALUE=
# REMNAWAVE_GATE_COOKIE=
