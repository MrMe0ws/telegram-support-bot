BOT_TOKEN=
# ID супергруппы с включёнными темами (forum), бот — админ с правом управлять топиками
SUPPORT_GROUP_ID=
# Через запятую: админы (доступ к /close в топике, /block, /unblock)
ADMIN_IDS=

# Важно: в @BotFather для бота выполните /setprivacy → Disable,
# иначе бот не получает обычные сообщения из группы и ответы саппорта не доходят до клиента.

# Уровень логов в консоль: DEBUG, INFO, WARNING, ERROR, CRITICAL (по умолчанию WARNING)
# Строки aiogram «Update … is handled» скрыты, пока не выставить LOG_LEVEL=DEBUG
LOG_LEVEL=WARNING

# SQLite в контейнере по умолчанию
DATABASE_URL=sqlite+aiosqlite:////data/support.db

# Плейсхолдеры: {username}, {ticket_id}, {uid}, {name}
TOPIC_NAME_TEMPLATE={username} · {ticket_id}

# Иконки темы форума (custom emoji ID из набора Telegram для топиков). Пустое значение — не менять иконку.
# TOPIC_ICON_EMOJI_OPEN=5377316857231450742
# TOPIC_ICON_EMOJI_CLOSED=5237699328843200968
# Значок «ждёт человека»: клиент написал, а ответить должен сотрудник (ИИ передал тикет,
# не смог ответить или выключен). Эмодзи из набора значков тем или его ID. Пусто — выключено.
# TOPIC_ICON_EMOJI_WAITING=❗

# Тексты UI: каталог texts/<BOT_LOCALE> (по умолчанию ru)
BOT_LOCALE=ru
# В Docker задано в образе. Для локального запуска при необходимости:
# TEXTS_DIR=./texts

# --- Remnawave (опционально, блок подписки в /profile) ---
# REMNAWAVE_ENABLED=true
# REMNAWAVE_URL=http://remnawave:3000
# REMNAWAVE_MODE=local
# REMNAWAVE_TOKEN=
# Как PANEL_DOMAIN в .env панели (рекомендуется при docker URL remnawave:3000)
# REMNAWAVE_HTTP_HOST=panel.example.com
# Для local по умолчанию true: X-Forwarded-For / X-Forwarded-Proto (иначе панель рвёт сокет)
# REMNAWAVE_PROXY_HEADERS=true
# REMNAWAVE_FORWARDED_FOR=127.0.0.1
# REMNAWAVE_FORWARDED_PROTO=https
# REMNAWAVE_SUB_PUBLIC_URL=https://sub.example.com

# --- Bridge к web-кабинету (remnawave-telegram-shop, SUPPORT_BOT_API=true) ---
# URL webhook shop: ответы саппорта и закрытие cabinet-тикета. В Docker — имя сервиса shop + HEALTH_CHECK_PORT.
# SHOP_WEBHOOK_URL=http://shop:8080/cabinet/api/internal/support/webhook
# Общий Bearer-секрет с shop (SUPPORT_BRIDGE_SECRET в .env shop). Без пары SHOP_WEBHOOK_URL + секрет cabinet-bridge не работает.
# SUPPORT_BRIDGE_SECRET=change-me-shared-secret
# Порт HTTP sidecar: POST /internal/cabinet/message (shop шлёт сюда через SUPPORT_BOT_API_URL)
# HTTP_PORT=8080
# REMNAWAVE_TIMEOUT_SEC=10
# BOT_TIMEZONE=Europe/Moscow

# REMNAWAVE_MODE=remote — если бот на другой машине, через публичный URL:
# REMNAWAVE_URL=https://panel.example.com
# REMNAWAVE_GATE_QUERY_NAME=
# REMNAWAVE_GATE_QUERY_VALUE=
# REMNAWAVE_GATE_COOKIE=

# --- ИИ-ответы клиентам (опционально) ---
# ИИ отвечает клиентам по базе знаний (папка knowledge/ с .md-файлами), а если
# не уверен или клиент просит человека — передаёт тикет сотрудникам.
# AI_ENABLED=true
# auto — ИИ отвечает клиенту сам; draft — присылает черновик в тему, отправляет админ кнопкой
# AI_MODE=auto
# Ключи API — по одному на провайдера; модели провайдера без ключа пропускаются.
# Google Gemini: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# OpenAI: https://platform.openai.com/api-keys
# OPENAI_API_KEY=
# Anthropic Claude: https://platform.claude.com/settings/keys
# ANTHROPIC_API_KEY=
# Основная модель. Провайдер — по имени (gemini-…, gpt-…, claude-…) или явно: openai:имя-модели
#   Gemini: gemini-2.5-flash · OpenAI: gpt-6-luna, gpt-6.1-sol · Claude: claude-opus-5-5, claude-sonnet-5-5, claude-haiku-4-5
# AI_MODEL=gemini-2.5-flash
# Резервные модели через запятую, по порядку: если модель не ответила (лимит, перегрузка, сбой),
# вопрос уходит следующей — в том числе другого провайдера. Пусто — без резервных
# AI_FALLBACK_MODELS=gemini-3.5-flash-lite, claude-sonnet-5-5, gpt-6-luna
# Основную и резервные можно менять прямо в боте: админ-панель → «⚙️ Настройки» → «🤖 ИИ-помощник» → «🧠 Модели»
# Провайдер для моделей, чьё имя не начинается с gemini/gpt/claude (и для старого AI_API_KEY)
# AI_PROVIDER=gemini
# Прокси до API (из РФ провайдеры напрямую недоступны): http://user:pass@host:port
# AI_PROXY_URL=
# Сколько секунд ждать тишины после сообщения клиента (клиент видит «печатает…»)
# AI_REPLY_DELAY_SEC=20
# Папка базы знаний (в Docker смонтирована в /app/knowledge)
# AI_KNOWLEDGE_DIR=knowledge
# Сколько последних сообщений тикета видит ИИ
# AI_HISTORY_LIMIT=30
# После скольких ответов ИИ в одном тикете передать его человеку
# AI_MAX_REPLIES_PER_TICKET=10
# AI_TIMEOUT_SEC=60
# Как подписаны ответы ИИ (в теме и в чате кабинета)
# AI_ASSISTANT_NAME=ИИ-помощник
# ИИ смотрит фото и файлы (PDF, .txt/.log) и слушает голосовые клиента (голосовые — только Gemini); false — только текст
# AI_MEDIA=true
# Файлы больше этого размера (МБ, до 20) ИИ не отправляются — тикет уходит человеку
# AI_MEDIA_MAX_MB=10
# С какого ответа ИИ в тикете показывать клиенту кнопку «Позвать человека»
# (1 — с первого, 3 — с третьего, 0 — никогда; словами позвать человека можно всегда)
# AI_HUMAN_BUTTON_FROM=0
